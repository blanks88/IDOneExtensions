# Configure these in the scheduler, container, CI or secret manager.
# This file is an example only; SyscomApp does not load .env files.
ALUSA_CONNECTION_STRING=REPLACE_WITH_CONNECTION_STRING
SYSCOM_CLIENT_ID=REPLACE_WITH_CLIENT_ID
SYSCOM_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# Optional application settings and defaults:
SYSCOM_MAXIMUM_DURATION_SECONDS=1800
SYSCOM_REQUEST_TIMEOUT_SECONDS=30
SYSCOM_RETENTION_DAYS=30
SYSCOM_COMPANY_ID=1
SYSCOM_PAGE_SIZE=500
SYSCOM_BUFFERED_PAGES=2
# SYSCOM_BASE_URL=https://developers.syscom.mx
# SYSCOM_OAUTH_TOKEN_PATH=/oauth/token
# SYSCOM_OAUTH_FORM_ENCODED=0

# Live test requires SYSCOM_RUN_INTEGRATION_TESTS=1 plus all of:
# SYSCOM_INTEGRATION_DATABASE_ISOLATED=1
# SYSCOM_INTEGRATION_CONNECTION_STRING=REPLACE_WITH_ISOLATED_DB_CONNECTION_STRING
# SYSCOM_INTEGRATION_CLIENT_ID=REPLACE_WITH_INTEGRATION_CLIENT_ID
# SYSCOM_INTEGRATION_CLIENT_SECRET=REPLACE_WITH_INTEGRATION_CLIENT_SECRET
# SYSCOM_INTEGRATION_COMPANY_ID=REPLACE_WITH_ISOLATED_COMPANY_ID
# SYSCOM_INTEGRATION_BASE_URL=http://127.0.0.1:5100
# SYSCOM_INTEGRATION_OAUTH_TOKEN_PATH=/api/v1/oauth/token
# SYSCOM_INTEGRATION_OAUTH_FORM_ENCODED=1
